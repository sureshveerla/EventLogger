[Application]
Version=4.0.1

[Database]
DB_IP=192.168.29.223
DB_Name=NMSDB
DB_Password=postgres@123
DB_Port=5432
DB_Username=postgres

[Loco]
Port=4451

[NMS]
NMS_IP=192.168.29.139
NMS_Port=12348

[Station1]
IP=192.168.29.223
Name=GULLAGUDA
Port=12345

[Station2]
IP=192.168.29.157
Name=SHANKARPALLI
Port=12345


[VC]
Interval_ms=1000000   ; 0xA2 send period, max 1000 per ICD
ELU_ID=2          ; 2=ELU-A (sender ID 0x0002), 3=ELU-B (0x0003)
Channel_ID=1      ; 0x01=ELU-A, 0x02=ELU-B

[KMS]
; ELU LAN IPs — reference only (ICD §D.5)
ELU_A_IP=192.168.10.10
ELU_B_IP=192.168.10.11

; Vital Controller — ELU sends responses back TO this
VC_IP=192.168.29.223
VC_PORT=8532

; RDSO Confirmed KMS Server — ELU forwards packets TO this via GSM/GPRS
KMS_SERVER_IP=192.168.29.223
KMS_SERVER_PORT=7000

; GSM modem — run: ls /dev/ttyUSB* /dev/ttyACM* /dev/ttyS*
; Fix permission: sudo usermod -aG dialout sana (re-login after)
GSM_Port=/dev/ttyUSB0
GSM_Baud=115200

; KAVACH identity
KAVACH_Unit_Type=0x11
KAVACH_Unit_ID=000001
